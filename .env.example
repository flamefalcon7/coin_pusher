DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=coinpusher

# Read-only password for grafana_ro DB role (RTP dashboard).
# After deploy, run once:
#   docker exec coin_pusher-postgres-1 psql -U postgres -d coinpusher \
#     -c "ALTER ROLE grafana_ro WITH PASSWORD '$GRAFANA_DB_PASSWORD'"
# Then restart grafana so the datasource picks up the env var.
GRAFANA_DB_PASSWORD=CHANGE_ME

# Base RPC (Alchemy recommended — https://dashboard.alchemy.com)
ALCHEMY_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# CORS Origins
CORS_ORIGINS=https://coinpush.fun,https://www.coinpush.fun

# Admin passcode login (POST /v1/auth/admin/login). Leave empty to disable.
# Must be >= 4 chars; anyone who knows it gets role=admin. Guessing is
# throttled: 3 failures within 10 minutes lock the route for everyone.
# If it leaks: change/clear it and restart the api. Already-issued admin
# tokens stay valid for up to 24h (JWT lifetime) unless you also rotate the
# signing key; the passcode account keeps role=admin but is unreachable once
# the route is gone (demote it with `admin set-role <id> user` if desired).
ADMIN_PASSCODE=
