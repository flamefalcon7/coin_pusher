          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.005 }, { "color": "green", "value": 0.01 }] },
          "color": { "mode": "thresholds" },
          "unit": "suffix: ETH"
